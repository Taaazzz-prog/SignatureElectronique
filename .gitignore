# .gitignore pour le REPOSITORY PUBLIC
# Ignore tout ce qui est sensible ou de déploiement

# ============================================================================
# 🔴 FICHIERS DE CONFIGURATION ET DÉPLOIEMENT (PRIVÉ UNIQUEMENT)
# ============================================================================

# Scripts PowerShell de déploiement
deploy*.ps1
build-and-push.ps1
monitor.ps1
fix-ssl.ps1
regenerate-ssl.ps1

# Configuration Docker
docker-compose.yml
docker-compose.prod.yml

# Documentation opérationnelle
CHANGEMENTS.md
GOODFLAG_INTEGRATION.md
MIGRATION_SWARM.md
STATUS.md
SECURITY_AUDIT.md

# Dossiers de configuration et organisation
config/
scripts/
documentation/
infrastructure/
secrets/
monitoring/
backups/
docs/
.projectstructure

# ============================================================================
# 📝 FICHIERS TOUJOURS IGNORÉS
# ============================================================================

# Environnement virtuel Python
venv/
.venv/
env/
ENV/
*.pyc
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Fichiers uploadés et signés (DONNÉES SENSIBLES)
uploads/
signed/
signatures/
*.pdf

# Fichiers de configuration et secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.crt

# Fichiers de configuration IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Logs
*.log
logs/

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Fichiers de base de données
*.db
*.sqlite
*.sqlite3
signature_app.db

# Backups
*.bak
*.backup
*.tmp

# Fichiers de test
test_uploads/
test_data/
