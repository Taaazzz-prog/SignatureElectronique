# .gitignore pour le REPOSITORY PRIVÉ
# Ignore seulement les fichiers générés et données sensibles

# Environnement virtuel Python
venv/
.venv/
env/
ENV/
*.pyc
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Fichiers uploadés et signés (DONNÉES SENSIBLES)
uploads/
signed/
signatures/
*.pdf

# Fichiers de configuration IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Logs
*.log
logs/

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Fichiers de base de données (trop gros pour Git)
*.db
*.sqlite
*.sqlite3
signature_app.db

# Backups de DB (trop gros)
backups/*.db
backups/*.sql
backups/*.tar.gz
backups/*.zip

# Fichiers temporaires
*.bak
*.backup
*.tmp

# Fichiers de test
test_uploads/
test_data/

# ⚠️ IMPORTANT : Le .env contient les vrais secrets
# Garder ce fichier dans Git pour backup, mais soyez conscient
# qu'il contient des secrets. Le repository DOIT être PRIVÉ !
# .env
