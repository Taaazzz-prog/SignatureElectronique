# Variables d'environnement - PRODUCTION
# ⚠️ FICHIER AVEC LES VRAIES VALEURS DE PRODUCTION

# ==============================================================================
# 🔐 SECRETS - COPIER VOS VRAIES VALEURS ICI
# ==============================================================================

# Clé secrète Flask (OBLIGATOIRE)
# ⚠️ REMPLACER par votre vraie clé de production
SECRET_KEY=VOTRE_VRAIE_CLE_SECRET_KEY_ICI

# Google reCAPTCHA v3 - Clé secrète
# ⚠️ REMPLACER par votre vraie clé reCAPTCHA secrète
RECAPTCHA_SECRET_KEY=VOTRE_VRAIE_CLE_RECAPTCHA_SECRETE_ICI

# Goodflag API Token (optionnel - pour signatures qualifiées)
# ⚠️ REMPLACER par votre token Goodflag si vous l'avez
GOODFLAG_API_TOKEN=

# ==============================================================================
# 📁 CONFIGURATION APPLICATION
# ==============================================================================

# Chemin de la base de données (dans le conteneur)
DATABASE_PATH=/app/data/signature_app.db

# Mode Flask
FLASK_ENV=production

# Debug (TOUJOURS False en production)
DEBUG=False

# ==============================================================================
# 🚨 INSTRUCTIONS
# ==============================================================================
# 
# 1. Récupérer votre SECRET_KEY depuis votre .env local actuel
#    Ou générer une nouvelle avec :
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Récupérer votre RECAPTCHA_SECRET_KEY depuis :
#    https://www.google.com/recaptcha/admin
#
# 3. Si vous utilisez Goodflag, ajouter GOODFLAG_API_TOKEN
#
# 4. Sauvegarder ce fichier
#
# 5. Utiliser create-secrets.ps1 pour créer les Docker Secrets
#
# ==============================================================================
